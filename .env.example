# Production canonical domain. No secrets here.
SITE_URL=https://каменьторг23.рф
# Server only: CRM/webhook which receives the structured lead as JSON.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
# Optional external endpoint for static hosting. Must allow the Pages origin via CORS.
NEXT_PUBLIC_LEAD_ENDPOINT=
# Set automatically for the Pages build; leave empty for production at the root domain.
NEXT_PUBLIC_BASE_PATH=

# Number of trusted reverse-proxy hops. Leave 0 for direct access.
# Set only when the application is reachable exclusively through your own proxy.
TRUST_PROXY_HOPS=0

# Vercel: PostgreSQL (e.g. Neon). No NEXT_PUBLIC prefix for server secrets.
DATABASE_URL=
# Vercel Blob public image store; connected via the Vercel Storage dashboard.
BLOB_READ_WRITE_TOKEN=
# Local/self-hosted mode only. Never use local SQLite for Vercel persistence.
CATALOG_DATA_DIR=./var/catalog
# Optional fine-grained GitHub token: Actions write for Mumortsev/Kamen only.
PAGES_GITHUB_TOKEN=
# Same random server-only token in Vercel env and GitHub Actions secret.
PAGES_CALLBACK_TOKEN=
# Optional link from read-only Pages admin to the real admin.
NEXT_PUBLIC_ADMIN_URL=
# CI only: public published catalog endpoint, e.g. https://project.vercel.app/api/catalog
CATALOG_EXPORT_URL=
