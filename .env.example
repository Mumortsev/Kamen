# Production canonical domain. No secrets here.
SITE_URL=https://каменьторг23.рф
# Server only: CRM/webhook which receives the structured lead as JSON.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
# Optional external endpoint for static hosting. Must allow the Pages origin via CORS.
NEXT_PUBLIC_LEAD_ENDPOINT=
# Set automatically for the Pages build; leave empty for production at the root domain.
NEXT_PUBLIC_BASE_PATH=

# Number of trusted reverse-proxy hops. Leave 0 for direct access.
# Set only when the application is reachable exclusively through your own proxy.
TRUST_PROXY_HOPS=0
